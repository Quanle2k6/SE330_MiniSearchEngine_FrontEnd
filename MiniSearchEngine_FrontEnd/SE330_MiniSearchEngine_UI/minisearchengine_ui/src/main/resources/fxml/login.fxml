<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="12" alignment="CENTER" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.LoginController" style="-fx-padding: 40; -fx-background-color: #ffffff;">
    <children>
        <Label text="Đăng nhập" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;" />
        <TextField fx:id="txtUsername" promptText="Tên đăng nhập" />
        <PasswordField fx:id="txtPassword" promptText="Mật khẩu" />
        <Button fx:id="btnLogin" text="Đăng nhập" onAction="#handleLogin" style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 20 8 20;" />
        <Button fx:id="btnShowRegister" text="Đăng ký" onAction="#handleShowRegister" style="-fx-background-color: #ffffff; -fx-border-color: #dfe1e5; -fx-cursor: hand;" />
        <Label fx:id="lblMessage" text="" />
    </children>
</VBox>
