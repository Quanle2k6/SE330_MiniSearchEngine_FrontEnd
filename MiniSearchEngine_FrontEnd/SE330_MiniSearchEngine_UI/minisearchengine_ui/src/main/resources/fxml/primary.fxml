<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.PrimaryController">
   <top>
      <VBox spacing="10.0" style="-fx-background-color: #f4f4f4;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🔍 Mini Search Engine" />
            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="txtSearchQuery" HBox.hgrow="ALWAYS" promptText="Nhập từ khóa tìm kiếm tại đây..." style="-fx-font-size: 14px;" />
                  <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch" prefWidth="100.0" style="-fx-font-size: 14px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Tìm kiếm" />
               </children>
            </HBox>
            <Label fx:id="lblStatus" style="-fx-text-fill: #7f8c8d;" text="Sẵn sàng." />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="vboxResults" spacing="15.0">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>