<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.PrimaryController">
   <top>
      <HBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 8; -fx-border-color: #e4e4e4; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #ffffff; -fx-border-color: #dfe1e5; -fx-text-fill: #3c4043; -fx-cursor: hand;" text="Back" />
            <Button fx:id="btnForward" mnemonicParsing="false" onAction="#handleForward" style="-fx-background-color: #ffffff; -fx-border-color: #dfe1e5; -fx-text-fill: #3c4043; -fx-cursor: hand;" text="Forward" />
            <Button fx:id="btnReload" mnemonicParsing="false" onAction="#handleReload" style="-fx-background-color: #ffffff; -fx-border-color: #dfe1e5; -fx-text-fill: #3c4043; -fx-cursor: hand;" text="Reload" />
            <TextField fx:id="urlBar" onAction="#handleUrlInput" prefWidth="360.0" promptText="Nhap URL..." style="-fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #dfe1e5; -fx-padding: 6 12 6 12;" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleNewTab" style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Tab Tìm Kiếm Mới" />
            <Button mnemonicParsing="false" onAction="#handleOpenHistory" style="-fx-background-color: #ffffff; -fx-border-color: #dfe1e5; -fx-text-fill: #3c4043; -fx-cursor: hand;" text="Lịch sử" />
            <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #ffffff; -fx-border-color: #dfe1e5; -fx-text-fill: #d93025; -fx-cursor: hand;" text="Đăng xuất" />
         </children>
      </HBox>
   </top>
   <center>
      <TabPane fx:id="mainTabPane" tabClosingPolicy="ALL_TABS" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
