<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="14" alignment="CENTER" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafx.OTPController" style="-fx-padding: 40; -fx-background-color: #ffffff;">
    <children>
        <Label text="Xác thực OTP" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;" />
        <Label text="Nhập mã OTP 6 ký tự đã gửi tới email của bạn." wrapText="true" style="-fx-text-fill: #5f6368; -fx-font-size: 14px;" />
        <HBox spacing="8" alignment="CENTER">
            <children>
                <TextField fx:id="txtOtp1" prefWidth="40" style="-fx-font-size: 18px; -fx-alignment: CENTER;" />
                <TextField fx:id="txtOtp2" prefWidth="40" style="-fx-font-size: 18px; -fx-alignment: CENTER;" />
                <TextField fx:id="txtOtp3" prefWidth="40" style="-fx-font-size: 18px; -fx-alignment: CENTER;" />
                <TextField fx:id="txtOtp4" prefWidth="40" style="-fx-font-size: 18px; -fx-alignment: CENTER;" />
                <TextField fx:id="txtOtp5" prefWidth="40" style="-fx-font-size: 18px; -fx-alignment: CENTER;" />
                <TextField fx:id="txtOtp6" prefWidth="40" style="-fx-font-size: 18px; -fx-alignment: CENTER;" />
            </children>
        </HBox>
        <Button fx:id="btnVerify" text="Xác thực" onAction="#handleVerifyOtp" style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 20 8 20;" />
        <Button fx:id="btnResendOtp" text="Gửi lại mã OTP" onAction="#handleResendOtp" style="-fx-background-color: #ffffff; -fx-border-color: #dfe1e5; -fx-cursor: hand;" />
        <Button fx:id="btnBackLogin" text="Quay lại đăng nhập" onAction="#handleBackLogin" style="-fx-background-color: #ffffff; -fx-border-color: #dfe1e5; -fx-cursor: hand;" />
        <Label fx:id="lblMessage" text="" wrapText="true" style="-fx-text-fill: #d93025; -fx-font-size: 13px;" />
    </children>
</VBox>
